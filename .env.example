# Compose-level variables (used by docker-compose.yml).
# App-level examples live in api/.env.example and web/.env.example.
PORT=3000
WEB_PORT=3001
POSTGRES_USER=blogetch
POSTGRES_PASSWORD=blogetch
POSTGRES_DB=blogetch
POSTGRES_TEST_DB=blogetch_test
# Secrets for local development only. Production values come from the environment.
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@blogetch.dev
ADMIN_PASSWORD=change-me-to-a-strong-password
